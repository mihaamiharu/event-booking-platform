{
  "name": "event-booking-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone event-management and booking product (R1 attendee journey).",
  "workspaces": [
    "client",
    "worker",
    "tests"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace=client",
    "preview": "npm run build --workspace=client && npm run preview --workspace=client",
    "setup:local": "node tools/setup-local.mjs",
    "lint:req-ids": "node tools/check-req-ids.mjs --strict-coverage",
    "lint:redaction": "node tools/check-redaction.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test \"tests/unit/**/*.test.ts\"",
    "test:db": "node --experimental-strip-types --no-warnings --test \"tests/db/**/*.test.ts\"",
    "test:e2e": "npm run test:e2e --workspace=tests",
    "serve:e2e": "node tools/serve-e2e.mjs",
    "lab:api": "node tools/lab-api.mjs",
    "smoke:preview": "node tools/preview-smoke.mjs",
    "test:traceability": "node tools/check-traceability.mjs",
    "test:api": "node tools/run-api-tests.mjs",
    "test:local": "npm run typecheck && npm run lint:req-ids && npm run lint:redaction && npm run test:unit && npm run test:db && npm run test:api && npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=22"
  }
}
