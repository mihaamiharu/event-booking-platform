# Local-only dev secrets — copy to `.dev.vars` (gitignored). Never commit real values.
# Preview secrets are set via `wrangler secret put --env preview` (S4 owns rotation).
WORKSPACE_SECRET=local-dev-only-workspace-secret
SESSION_SECRET=local-dev-only-session-secret
TURNSTILE_SECRET=dummy-disabled-locally
DEPLOYMENT_ENV=local
# Optional external evidence links; leave blank to keep the cockpit provider-neutral.
QA_CLOUDFLARE_LOGS_URL=
QA_GRAFANA_URL=
# Teaching defects are disabled by default. Set both flags explicitly for a
# local/disposable practice run; production ignores all scenario profiles.
SCENARIO_PROFILES_ENABLED=false
SCENARIO_PROFILE=baseline
