{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.jsonc",
  "name": "ebp-r1",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../client/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SEED_VERSION": "r1-v1",
    "DEPLOYMENT_ENV": "production",
    "QA_CLOUDFLARE_LOGS_URL": "",
    "QA_GRAFANA_URL": "",
    "SCENARIO_PROFILES_ENABLED": "false",
    "SCENARIO_PROFILE": "baseline"
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ebp-r1-local",
      "database_id": "local-s1-placeholder",
      "migrations_dir": "../db/migrations"
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "DEPLOYMENT_ENV": "preview",
        "SCENARIO_PROFILES_ENABLED": "false",
        "SCENARIO_PROFILE": "baseline"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ebp-preview",
          "database_id": "preview-id-swapped-at-deploy-time",
          "migrations_dir": "../db/migrations"
        }
      ]
    }
  }
}
